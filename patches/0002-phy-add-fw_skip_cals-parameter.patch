--- a/drivers/net/wireless/mediatek/mt7601u/phy.c
+++ b/drivers/net/wireless/mediatek/mt7601u/phy.c
@@ -13,6 +13,13 @@
 
 #include <linux/etherdevice.h>
 
+/* Buggy MT7601U clone dongles hang on MCU calibration commands (community
+ * workaround from Launchpad bug #1716301 / kuba-moo issue #64).
+ */
+static bool fw_skip_cals;
+module_param(fw_skip_cals, bool, 0644);
+MODULE_PARM_DESC(fw_skip_cals, "Skip MCU RF calibrations (RXIQ/DPD etc.) that hang buggy clones");
+
 static void mt7601u_agc_reset(struct mt7601u_dev *dev);
 
 static int
@@ -589,7 +596,8 @@
 	if (test_bit(MT7601U_STATE_REMOVED, &dev->state))
 		return;
 
-	mt7601u_mcu_calibrate(dev, MCU_CAL_DPD, dev->curr_temp);
+	if (!fw_skip_cals)
+		mt7601u_mcu_calibrate(dev, MCU_CAL_DPD, dev->curr_temp);
 
 	mt7601u_rxdc_cal(dev);
 }
@@ -1131,9 +1139,11 @@
 
 	mac_ctrl = mt7601u_rr(dev, MT_MAC_SYS_CTRL);
 
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_R, 0);
-	if (ret)
-		return ret;
+	if (!fw_skip_cals) {
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_R, 0);
+		if (ret)
+			return ret;
+	}
 
 	ret = mt7601u_rf_rr(dev, 0, 4);
 	if (ret < 0)
@@ -1144,27 +1154,32 @@
 		return ret;
 	msleep(2);
 
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_TXDCOC, 0);
-	if (ret)
-		return ret;
+	if (!fw_skip_cals) {
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_TXDCOC, 0);
+		if (ret)
+			return ret;
+	}
 
 	mt7601u_rxdc_cal(dev);
 
 	ret = mt7601u_set_bw_filter(dev, true);
 	if (ret)
 		return ret;
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_LOFT, 0);
-	if (ret)
-		return ret;
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_TXIQ, 0);
-	if (ret)
-		return ret;
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_RXIQ, 0);
-	if (ret)
-		return ret;
-	ret = mt7601u_mcu_calibrate(dev, MCU_CAL_DPD, dev->dpd_temp);
-	if (ret)
-		return ret;
+
+	if (!fw_skip_cals) {
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_LOFT, 0);
+		if (ret)
+			return ret;
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_TXIQ, 0);
+		if (ret)
+			return ret;
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_RXIQ, 0);
+		if (ret)
+			return ret;
+		ret = mt7601u_mcu_calibrate(dev, MCU_CAL_DPD, dev->dpd_temp);
+		if (ret)
+			return ret;
+	}
 
 	mt7601u_rxdc_cal(dev);
 
